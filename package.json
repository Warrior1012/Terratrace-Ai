{
  "name": "terratrace-static",
  "version": "0.9.0",
  "private": true,
  "description": "TerraTrace static Sentinel-2 comparison prototype",
  "scripts": {
    "build:site": "node scripts/build-site.js",
    "assets:brand": "node scripts/generate-brand-assets.js",
    "test:e2e": "playwright test",
    "test:browser-unit": "playwright test tests/browser-unit.spec.js",
    "audit:lighthouse": "lighthouse http://127.0.0.1:4173/ --chrome-flags=\"--headless --no-sandbox\" --only-categories=accessibility,performance --output=json --output-path=./lighthouse-report.json"
  },
  "dependencies": {
    "geotiff": "2.1.3",
    "leaflet": "1.9.4",
    "png-to-ico": "2.1.0",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "lighthouse": "12.8.2"
  }
}